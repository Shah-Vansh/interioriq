DATABASE_URL=sqlite:///./interioriq.db
SECRET_KEY=change-me
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
STORAGE_PATH=../../storage

# Email (optional, zero cost). Example for Gmail: create an "App password" in your Google account (2-step verification must be on).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM=Your Studio <you@gmail.com>
# PUBLIC_URL=http://localhost:3000

# ── Schema migrations + background jobs (M23) ─────────────────────────────────
# The API runs `alembic upgrade head` at start-up. With several API servers, set AUTO_MIGRATE=false on them and run it once per deploy:
#   cd apps/api && alembic upgrade head
# AUTO_MIGRATE=true
# Background jobs (document OCR, email sending): "thread" runs them inside the API process (one server, zero setup).
# "celery" hands them to worker processes — run several API servers and workers. The broker can be a plain database (free, no server):
# TASK_BACKEND=celery
# CELERY_BROKER_URL=sqla+sqlite:///./celery-broker.db          # or sqla+postgresql://user:pass@host/db, or redis://localhost:6379/0
#   then start a worker (same .env):  cd apps/api && celery -A app.worker worker --loglevel=info   (Windows: add --pool=solo)
# OCR_STALE_MINUTES=30
# EMAIL_STALE_MINUTES=10

# ── Backups (M24) ─────────────────────────────────────────────────────────────
# BACKUP_DIR=../../backups      # keep outside the web root; shared folder with several servers; copy it off the machine regularly
# BACKUP_DAILY=true             # one automatic backup per local day after BACKUP_HOUR
# BACKUP_HOUR=2
# BACKUP_KEEP=14
# Postgres (see docs/DEPLOYMENT.md):  pip install "psycopg[binary]"
# DATABASE_URL=postgresql+psycopg://interioriq:password@localhost:5432/interioriq
# SECRET_KEY=change-me-to-a-long-random-string
# PUBLIC_URL=https://iq.example.com

# PDFs: the rupee sign and Gujarati / Hindi text. By default an installed font that has them is found automatically
# (Windows: Nirmala UI, built in; Linux: apt install fonts-freefont-ttf). Settings -> System shows which font is used.
# PDF_FONTS=auto            # or builtin = Helvetica, Latin only, amounts as 'Rs.'
# PDF_FONT_PATH=            # force a .ttf (it must contain the glyphs you need)
# PDF_FONT_BOLD_PATH=

# Design chat (AI Designer): uses a local Ollama model when one is running; otherwise built-in rules (no setup needed).
# DESIGN_CHAT_LLM=true
